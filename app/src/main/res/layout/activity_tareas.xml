<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:clipToPadding="false"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="32dp"
            android:text="Gestión de Tareas"
            android:textColor="#2979FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progreso General"
                    android:textColor="#2979FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginBottom="16dp"
                    android:progress="50"
                    android:progressTint="#00E5FF"
                    android:progressBackgroundTint="#E2E8F0" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TableRow android:gravity="center_vertical">
                        <TextView
                            android:padding="8dp"
                            android:text="Categoría:"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <Spinner
                            android:id="@+id/spinnerCategoria"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:theme="@style/ThemeOverlay.AppCompat.Light" />
                    </TableRow>

                    <TableRow android:layout_marginTop="12dp" android:gravity="center_vertical">
                        <TextView
                            android:padding="8dp"
                            android:text="Importancia:"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <!-- Scale down RatingBar to fit nicely without cutting off -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical">
                            <RatingBar
                                android:id="@+id/ratingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:rating="3"
                                android:stepSize="1"
                                android:scaleX="0.8"
                                android:scaleY="0.8"
                                android:transformPivotX="0dp"
                                android:transformPivotY="16dp"
                                android:progressTint="#2979FF" />
                        </LinearLayout>
                    </TableRow>
                </TableLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva Tarea"
                    android:textColor="#2979FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etNuevaTarea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ingrese comando de tarea..."
                    android:textColorHint="#94A3B8"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado del sistema:"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPendiente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:textColor="#1E293B"
                        android:buttonTint="#2979FF"
                        android:text="Pendiente" />

                    <RadioButton
                        android:id="@+id/rbEnProceso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1E293B"
                        android:buttonTint="#2979FF"
                        android:text="En Proceso" />

                    <RadioButton
                        android:id="@+id/rbCompletada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1E293B"
                        android:buttonTint="#2979FF"
                        android:text="Completada" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/cbUrgente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:textColor="#FF1744"
                    android:buttonTint="#FF1744"
                    android:textStyle="bold"
                    android:text="PRIORIDAD CRÍTICA (URGENTE)" />

                <Button
                    android:id="@+id/btnAgregarDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Añadir Datos Adicionales"
                    android:layout_marginBottom="12dp"
                    android:textColor="#2979FF"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_secondary"/>

                <Button
                    android:id="@+id/btnGuardarTarea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agregar Tarea"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Registro de Tareas"
                    android:textColor="#2979FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewTareas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>